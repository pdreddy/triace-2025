{
  "rules": {
    ".read": false,
    ".write": false,
    "pprcMaster": {
      ".read": true
    },
    "pprcClubs": {
      ".read": true
    },
    "traice2_0": {
      ".read": "auth != null && auth.token.admin === true",
      "settings": {
        ".read": true
      },
      "tierConfig": {
        ".read": true
      },
      "configRevision": {
        ".read": true
      },
      "tiers": {
        ".read": true
      },
      "registrations": {
        ".read": "auth != null && auth.token.admin === true",
        "$teamId": {
          ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || data.child('owners').child(auth.uid).val() === true)"
        }
      },
      "fixtures": {
        ".read": true
      },
      "teamsByOwner": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "leagueRules": {
        ".read": true
      },
      "season": {
        ".read": true
      },
      "seasons": {
        ".read": true
      },
      "schedules": {
        ".read": true
      },
      "earlyBird": {
        ".read": true
      },
      "calendar": {
        ".read": true
      },
      "partnerPosts": {
        ".read": true
      },
      "partnerPrivate": {
        "$postId": {
          ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || auth.token.admin === true)"
        }
      },
      "partnerByOwner": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "ladder": {
        "index": {
          ".read": true
        },
        "public": {
          ".read": true
        },
        "accounts": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "private": {
          "$seasonId": {
            "requests": {
              "$playerId": {
                ".read": "auth != null && data.parent().parent().parent().parent().child('accounts').child(auth.uid).val() === $playerId"
              }
            },
            "notifications": {
              "$playerId": {
                ".read": "auth != null && data.parent().parent().parent().parent().child('accounts').child(auth.uid).val() === $playerId"
              }
            }
          }
        }
      },
      "season1": {
        ".read": true
      }
    }
  }
}
