      },
      "teamsByOwner": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "leagueRules": {
        ".read": true
      },
      "season": {
        ".read": true
      },
      "seasons": {
        ".read": true
      },
      "schedules": {
        ".read": true
      },
      "earlyBird": {
        ".read": true
      },
      "season1": {
        ".read": true
      }
    }
  }
