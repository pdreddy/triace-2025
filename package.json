{
  "name": "traice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm --prefix functions ci",
    "dev": "vite",
    "demo": "vite --mode demo",
    "dev:emulators": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-traice-2 --only auth,database,functions",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "test": "node --test tests/unit/tournament.test.js",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-traice-2 --only auth,database,functions \"node --test --test-concurrency=1 tests/firebase/functions.test.js tests/firebase/security.test.js\"",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
